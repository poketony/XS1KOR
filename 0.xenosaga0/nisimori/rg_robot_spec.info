# ----------------------------------------------------------------------
%  デリミタ。消去禁止
# ----------------------------------------------------------------------

# engine-power          エンジン出力(移動：kg * m/sec^2)
#                       500Kg のものを秒速50mに３秒でする出力は 500 * 50 / 3
# roll-power M RV TIME  エンジン出力(回転：kg * 1回転/sec^2)
#                       ５００Ｋｇのものを秒速２回転に３秒でできる出力は M=500 RV=2 TIME=3
# move-spd-max          移動最高速(m/sec)。実はrot-spd-bottom-rate でしか使っていない
# rot-spd-max           回転最高速(１回転に必要な秒数 sec)
# rot-spd-bottom-rate   (移動速度÷移動最高速)に対する回転最高速の割合(０から１まで）
# weight                質量(kg)

# dash-time             ダッシュ時間
# dash-power            ダッシュ時のエンジンパワー倍率
# dash-cooldown         ダッシュのクールダウン時間

# move-resist			運動（移動）抵抗
# rot-resist			運動（回転）抵抗

# life                  初期ライフ値
# damage-stiff-time     ダメージに対する硬直時間(sec/1damage)


# ＶＸ−１００００（赤いの）
character	vx01

	body-attack-damage  16.0

	move-spd-max        22.0
	dash-spd-max        40.0
	engine-power        1100000.0

	roll-power          2000.0 1.0 0.2
	rot-spd-max          2.0
	rot-spd-bottom-rate 0.2
	weight              1000.0

    #dash-mode normal
	dash-time         0.3
	dash-power        2.0
	dash-cooldown     10.0

    dash-mode neo2		# normal:最初のダッシュ vr:ＶＲダッシュ neo:ニュータイプダッシュ
	dash-time         4.0
        dash-power        2.2
	dash-cooldown     20.0
  
	move-resist			9.0
	rot-resist			9.0

	life				115.0
	damage-stiff-time	0.02

	# auto-homing           自動ターゲッティング（ホーミング）設定。２つまで
	#
	#                         書式 auto-homing  ホーミング速度 条件 条件 … .
	#                  
	#                       最後に . （半角ピリオド）が必要です。条件に使用できるもの。
	#                         see-target : 敵機が隠れていない（背景の向こう側にいない）
	#                         lock-on    : ロックオン中
	#                         shot       : ショット中（攻撃中ではない）
	#                         in-scrn    : 画面内にいる
	#
	#                       自動ターゲッティングは２つ以上設定できません

	auto-homing         0.03 lock-on see-target .         # ロックオン且つ遮蔽物が無い時
	auto-homing         0.44 lock-on shot .               # ロックオン且つショットしたとき

	# エフェクト
	jet-eff eff04.ptcl      # ジェット
	dash-eff eff01.ptcl     # ダッシュ

