# 拡散ビームポッド   BMP45VX
shottype BMP45VX
  name ワイドビームポッド
  3wa
  model bp00

  vshotsnd 28   1.0        #ビーム音
  vhitsnd 29    1.0        #ビームヒット
  vbgsnd 36     1.0        #BG破壊



  occupy right  xxx-xo-mxx
  occupy back  xxx-xo-mxx
  lock -25   25      # ロックできる範囲(度)

  # full-mot の有り無しについては、下の注）を参照
  #cont notlock full-mot .
  cont notlock .

  shot T_BMP45VX     # ショット(rg_shot.info 参照)
  num  50            # ショット数(弾数)
  busy 1.0           # ショット後の busy 時間(sec)
  weight 220.0       # 重量

# ショット方向補正(ロックオン時は無効)
  v-dir  -1.6
  h-dir  -0.7


  # 使用キャラ
  use vx01 ag02 vx02 ag04 ag05 vx06 .

  # ビームポッド初期モーション
  basemot-all (
    ag02  nul wmot_60 wmot_60
    ag04  nul wmot_63 wmot_63
    ag05  nul wmot_66 wmot_66
    vx01  nul wmot_69 wmot_69
    vx02  nul wmot_72 wmot_72
    vx06  nul wmot_77 wmot_77
  )

  # ビームポッド攻撃モーション
  selfmot-all (
    ag02  nul wmot_61 wmot_61
    ag04  nul wmot_64 wmot_64
    ag05  nul wmot_67 wmot_67
    vx01  nul wmot_70 wmot_70
    vx02  nul wmot_73 wmot_73
    vx06  nul wmot_78 wmot_78
  )

  # 注）
  # ロボットモーションがない場合の、shottype (enetype) の挙動について
  #
  # full-mot なし
  #   ロボットモーションは再生されない(手は動かない)。通常の移動攻撃と同じ。
  #   武器モーションが指定されていれば武器モーションのみが再生される。
  #   射出開始フレームはテキトウな値(0.2秒後から射出 0.4 秒後に終了)
  #   
  # full-mot あり
  #   立ちモーションで硬直する。硬直時間は「立ちモーション１回分」
  #
  #
  #
  # 拡散ビームポッドはロボットモーションがない。これは
  #
  #  モーションがない、モーションの情報がない
  #  →基本的に硬直ができない(硬直情報がない)
  #  →移動と同時に合成再生するべきモーションもない
  #
  #  拡散ビームポッドは「腕でも背中」でも装備できる
  #  →モーションがないので、普通のショット系武器のように移動モーションに
  #    合成できない
  #  →ロボットモーションがあったとしても背中装備時は片手通常武器のように
  #    合成はできない（合成再生が、背中で対応しないため）
  #
  # という shottype(enetype) でも atktype でもシステマティックな解消が難しい
  # ジレンマが発生する。
  #  
  # こういった場合、full-mot の指定のあるなしで挙動がわけて強引に解消する
  # ようにした
  #
  # ちなみに、notlock が指定されていないと、ロックオン処理をしてしまうので、
  # 話はかなりややこしくなる。ロックオン指定をした場合はディフォルトの
  # ショットモーションでもいいから、ロボットモーションを指定するほうが良い。

