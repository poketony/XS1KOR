#
# equip ???-??-??? は装備設定です。
# ? は 'o'(小文字のオー)なら装備可能
# 'x'(小文字エックス)なら装備不可能をあらわします。
# フォーマットは以下のとおりです
#
# ？？？−？？−？？？
# 左左左　背背　右右右
# 手肘肩　中中　肩肘手
# 　　　　左右
#
# つまり人を後ろから見ている感じです。
# 左肘と右手に装備できる（？）武器は
#  xox-xx-xxo
# となります。equip を指定しないときはディフォルトで
#  oxx-xx-xxo  (両手だけ)
# となります。

#
# 各武器タイプによるモーションのディフォルト
#
# shottype
# enetype   -> mot shot_left_handgun  shot_right_handgun  nul
#
# atktype   -> mot brade_left         brade_right         nul
#

# use は無指定のときは全キャラ使用可能になります。

sudetype UNARMED
  default
  name 未装備

  vshotsnd 14    0.5       #剣音
  vhitsnd 22     1.0       #実弾ヒット
  vbgsnd 36      1.0       #BG破壊


  occupy LEFT xxx-xx-xxx
  occupy RIGHT xxx-xx-xxx
  occupy BACK xxx-xx-xxx
  damage 13
  lock -20   80      # ロックできる範囲(度)
  hiteff eff05.ptcl # ＨＩＴエフェクト
# sudetype SUDE_VX01 damage 3 use vx01 . name 素手 equip oxx-xx-xxo
# sudetype SUDE_VX02 damage 3 use vx02 . name 素手 equip oxx-xx-xxo
# sudetype SUDE_VX06 damage 3 use vx06 . name 素手 equip oxx-xx-xxo
# sudetype SUDE_AG05 damage 3 use ag05 . name 素手 equip oxx-xx-xxo
# sudetype SUDE_AG02 damage 3 use ag02 . name 素手 equip oxx-xx-xxo
# sudetype SUDE_AG04 damage 3 use ag04 . name 素手 equip oxx-xx-xxo
  
# 　１話-------------------------------------------------------

