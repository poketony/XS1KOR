# 普通の弾より小さくて早い（ダメージ小）(ガトリング用)
normal s-tama-S  # normal 名前 : ただ飛んでいくだけの弾
  #model de_mss     # 表示モデル
  puttex beam.bmp # テクスチャで直接弾表示
  spd 165.0      # 速度(m/sec)
  damage 0.2     # ダメージ
  life 2.0       # 生きている時間

  not-dam-time  1.5   # 1.5 秒の間に…
  not-dam-limit 5.0   # 5.0 以上のダメージを受けたらやられアクションが出る。
  slow-time     0.3   # 上記でないときのダメージＨＩＴは、0.5 秒の間…
